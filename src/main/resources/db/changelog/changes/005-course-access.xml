<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <changeSet id="005-course-access" author="lms">
        <createTable tableName="course_access">
            <column name="course_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="user_id" type="VARCHAR(255)"><constraints nullable="false"/></column>
        </createTable>
        <addPrimaryKey tableName="course_access" columnNames="course_id,user_id" constraintName="pk_course_access"/>
        <addForeignKeyConstraint baseTableName="course_access" baseColumnNames="course_id"
                                 referencedTableName="courses" referencedColumnNames="id"
                                 constraintName="fk_access_course" onDelete="CASCADE"/>
        <createIndex tableName="course_access" indexName="idx_course_access_user">
            <column name="user_id"/>
        </createIndex>
        <rollback><dropTable tableName="course_access"/></rollback>
    </changeSet>
</databaseChangeLog>
