<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <changeSet id="004-create-attachments" author="lms">
        <createTable tableName="attachments">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_attachments"/>
            </column>
            <column name="name" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="url" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_attachment_url"/>
            </column>
            <column name="lesson_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="created_time" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableName="attachments" baseColumnNames="lesson_id"
                                 referencedTableName="lesson" referencedColumnNames="id"
                                 constraintName="fk_attachment_lesson" onDelete="RESTRICT"/>
        <createIndex tableName="attachments" indexName="idx_attachment_lesson_id">
            <column name="lesson_id"/>
        </createIndex>
        <rollback><dropTable tableName="attachments"/></rollback>
    </changeSet>
</databaseChangeLog>
